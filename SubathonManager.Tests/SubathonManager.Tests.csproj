<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <AssemblyName>SubathonManager.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="*" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="*" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="*" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="*" />

    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="SubathonManager.Core" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubathonManager.Core\SubathonManager.Core.csproj" />
    <ProjectReference Include="..\SubathonManager.Data\SubathonManager.Data.csproj" />
    <ProjectReference Include="..\SubathonManager.Integration\SubathonManager.Integration.csproj" />
    <ProjectReference Include="..\SubathonManager.Server\SubathonManager.Server.csproj" />
    <ProjectReference Include="..\SubathonManager.Services\SubathonManager.Services.csproj" />
  </ItemGroup>
</Project>
