<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctl="using:SubathonManager.UI.Controls"
             xmlns:val="using:SubathonManager.UI.Validation"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             x:Class="SubathonManager.UI.Views.Prompts.PromptsEditor">
    <Grid x:Name="RootGrid" Focusable="True" PointerPressed="Grid_PointerPressed" ColumnDefinitions="3*,2*">

        <Border Grid.Column="0" Padding="8" Margin="16,16,8,16" BorderThickness="1" BorderBrush="#333" CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="SetNameTextBox" FontWeight="Bold" FontSize="18" IsTabStop="False"
                             PlaceholderText="Set name..." Height="38" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="2"
                             LostFocus="SetNameTextBox_LostFocus"/>
                    <Button Grid.Column="1" x:Name="RunOrCancelBtn" Classes="iconbtn" Width="30" Height="30" Margin="0,0,4,0"
                            ToolTip.Tip="Run a random prompt now" Click="RunOrCancel_Click">
                        <ctl:SymIcon x:Name="RunOrCancelIcon" Glyph="Play16"/>
                    </Button>
                    <Button Grid.Column="2" Classes="iconbtn" Width="30" Height="30"
                            ToolTip.Tip="Add New Prompt" Click="AddPrompt_Click">
                        <ctl:SymIcon Glyph="Add16"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,4,0,2">
                    <Grid Margin="4,0,8,5" ColumnDefinitions="28,*,76,55,50,80,66">
                        <TextBlock Grid.Column="0" Text="On" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Prompt Text" FontSize="11" Foreground="Gray" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Value" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Dur" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Qty" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" x:Name="PromptsScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PromptsStack" Orientation="Vertical" Margin="0,2,0,0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,16,56" VerticalAlignment="Top">

                    <TextBlock Text="Prompts Editor" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                        <ComboBox x:Name="SetSelectorBox" Height="36" HorizontalAlignment="Stretch"
                                  SelectionChanged="SetSelectorBox_SelectionChanged"/>
                        <Button Grid.Column="1" Classes="iconbtn" Width="34" Height="34" Margin="4,0,0,0"
                                ToolTip.Tip="New prompt set" Click="NewSet_Click">
                            <ctl:SymIcon Glyph="Add16"/>
                        </Button>
                        <Button Grid.Column="2" x:Name="DeleteSetBtn" Classes="iconbtn" Width="34" Height="34" Margin="4,0,0,0"
                                ToolTip.Tip="Delete this prompt set" Click="DeleteSet_Click" Foreground="Red">
                            <ctl:SymIcon Glyph="Delete16"/>
                        </Button>
                        <Border Grid.Column="3" Width="1" Background="#444" Margin="8,4"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Enabled" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <CheckBox x:Name="SetEnabledCheck" VerticalAlignment="Center"
                                      IsCheckedChanged="SetEnabled_Changed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="ExportPromptSet_Click" Height="30" Padding="12,4" Margin="0,0,6,0"
                                ToolTip.Tip="Export this prompt set to CSV">
                            <ctl:SymIcon Glyph="ArrowExportUp16"/>
                        </Button>
                        <Button Click="ImportPromptSet_Click" Height="30" Padding="12,4"
                                ToolTip.Tip="Import a prompt set from CSV">
                            <ctl:SymIcon Glyph="ArrowDownload16"/>
                        </Button>
                    </StackPanel>

                    <Border Padding="10" BorderThickness="1" BorderBrush="#333" CornerRadius="6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Timing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4" ColumnDefinitions="Auto,*,80,Auto">
                                <TextBlock Text="Interval:" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="SetIntervalBox" Grid.Column="2" Height="34" val:NumericInputBehaviour.Mode="Integer"
                                         ToolTip.Tip="How often (minutes) the set tries to fire a prompt"/>
                                <TextBlock Grid.Column="3" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                            </Grid>
                            <Grid Margin="0,0,0,4" ColumnDefinitions="Auto,*,80,Auto">
                                <TextBlock Text="Offset:" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="SetOffsetBox" Grid.Column="2" Height="34" val:NumericInputBehaviour.Mode="Integer"
                                         ToolTip.Tip="Max random amount of time +- from the interval to add variety"/>
                                <TextBlock Grid.Column="3" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,80,Auto">
                                <TextBlock Text="Cooldown:" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="SetCooldownBox" Grid.Column="2" Height="34" val:NumericInputBehaviour.Mode="Integer"
                                         ToolTip.Tip="Minutes to wait after a prompt ends before the next one can start."/>
                                <TextBlock Grid.Column="3" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PromptDetailBorder" Padding="10" BorderThickness="1" BorderBrush="#333" CornerRadius="6"
                            Margin="0,0,0,12" IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="Selected Prompt" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Border x:Name="RunningLockText" IsVisible="False" Background="#22FF8800" BorderBrush="#66FF8800"
                                    BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="⏵ This prompt is currently running - editing is locked."
                                           FontSize="12" Foreground="Orange"/>
                            </Border>

                            <TextBlock Text="Text:" FontSize="12" Margin="2,0,0,3"/>
                            <TextBox x:Name="PromptTextBox" PlaceholderText="What should viewers do..." Height="36" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8" ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <TextBlock Text="Type:" FontSize="12" Margin="2,0,0,3"/>
                                    <ComboBox x:Name="PromptTypeBox" Height="36" HorizontalAlignment="Stretch"
                                              SelectionChanged="PromptType_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="How?" FontSize="12" Margin="2,0,0,3"/>
                                    <ComboBox x:Name="PromptSubTypeBox" Height="36" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="EventTypePanel" IsVisible="False" Margin="0,0,0,8">
                                <TextBlock Text="Event:" FontSize="12" Margin="2,0,0,3"/>
                                <Button x:Name="EventTypePickerBtn" Height="36" MinWidth="130" Margin="0,0,0,2"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="8,0,6,0" Click="EventTypePickerBtn_Click">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="EventTypePickerLabel" Text="- select -" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ctl:SymIcon Grid.Column="1" Glyph="ChevronDown12" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="TierFilterPanel" IsVisible="False" Margin="0,0,0,8">
                                <TextBlock Text="Tier:" FontSize="12" Margin="2,0,0,3"/>
                                <ComboBox x:Name="PromptTierBox" Height="36" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8" ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <TextBlock x:Name="ValueLabel" Text="Target Value:" FontSize="12" Margin="2,0,0,3"/>
                                    <TextBox x:Name="PromptValueBox" Height="36" val:NumericInputBehaviour.Mode="Integer"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration (min):" FontSize="12" Margin="2,0,0,3"/>
                                    <TextBox x:Name="PromptDurationBox" Height="36" val:NumericInputBehaviour.Mode="Integer"
                                             ToolTip.Tip="How many minutes viewers have to complete this prompt"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8" ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <TextBlock Text="Quantity:" FontSize="12" Margin="2,0,0,3"/>
                                    <TextBox x:Name="PromptQuantityBox" Height="36" val:NumericInputBehaviour.Mode="Integer"
                                             ToolTip.Tip="How many times this prompt can succeed. Ignored if Infinite is on."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <CheckBox x:Name="PromptInfiniteCheck" Content="Infinite (no limit)"
                                              IsCheckedChanged="PromptInfinite_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="SaveButtonBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Margin="6,10,14,10">
                <Button x:Name="SaveBtn" Content="Save Changes" Classes="accent" Click="Save_Click" Width="140" Height="38"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
