<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctl="using:SubathonManager.UI.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             x:Class="SubathonManager.UI.Views.Schedule.ScheduleView">

    <UserControl.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Border.day">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.day:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.day.othermonth">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.day.today">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.day.selected">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.day Ellipse.pending">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.day Ellipse.alldone">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Border.day.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Border.day.selected Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Border.day.droptarget">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.day.selected.droptarget">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style Selector="Border.schedrow">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,6,8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.schedrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.schedrow.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.schedrow.done TextBlock.title">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="Border.upcoming">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.upcoming:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="360,*">

        <Border Grid.Column="0" Padding="10" Margin="16,16,8,16" BorderThickness="1" BorderBrush="#333"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                    <Button Grid.Column="0" Classes="iconbtn" Width="32" Height="32" ToolTip.Tip="Previous month"
                            Click="PrevMonth_Click">
                        <ctl:SymIcon Glyph="ChevronLeft16" />
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="MonthLabel" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="iconbtn" Width="32" Height="32" ToolTip.Tip="Next month"
                            Click="NextMonth_Click">
                        <ctl:SymIcon Glyph="ChevronRight16" />
                    </Button>
                    <Button Grid.Column="3" Height="32" Padding="10,0" Margin="6,0,0,0" Content="Today"
                            ToolTip.Tip="Jump to today" Click="Today_Click" />
                </Grid>

                <UniformGrid Grid.Row="1" x:Name="WeekdayHeader" Columns="7" Rows="1" Margin="0,0,0,2" />

                <UniformGrid Grid.Row="2" x:Name="DayGrid" Columns="7" Rows="6" />

                <Grid Grid.Row="3" ColumnDefinitions="*,*,*" Margin="2,10,2,0">
                    <Button Grid.Column="0" Height="32" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" ToolTip.Tip="Export schedule to CSV"
                            Click="ExportCsv_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:SymIcon Glyph="ArrowExportUp16" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Height="32" Margin="4,0,4,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Bulk delete completed, older or all schedule items"
                            Click="BulkDelete_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:SymIcon Glyph="Delete16" />
                            <TextBlock Text="Delete..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Height="32" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" ToolTip.Tip="Import schedule items from CSV"
                            Click="ImportCsv_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:SymIcon Glyph="ArrowDownload16" />
                            <TextBlock Text="Import" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Separator Grid.Row="4" Margin="0,12,0,8" />

                <Grid Grid.Row="5" RowDefinitions="Auto,*">
                    <TextBlock Text="Upcoming" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UpcomingStack" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="8,16,16,16" RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="4,0,0,10">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="DayTitle" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="DaySummary" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" Height="34" Padding="10,0" Margin="6,0,0,0"
                        ToolTip.Tip="Reorder this day's items by start time, all-day items first"
                        Click="SortByTime_Click">

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:SymIcon Glyph="Clock16" />
                        <TextBlock Text="Sort by time" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Height="34" Padding="10,0" Margin="6,0,0,0" Click="AddEvent_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:SymIcon Glyph="CalendarAdd16" />
                        <TextBlock Text="Event" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Height="34" Padding="10,0" Margin="6,0,0,0" Click="AddTask_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:SymIcon Glyph="TaskListSquareAdd16" />
                        <TextBlock Text="Task" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" x:Name="ItemsListBorder" Padding="8" BorderThickness="1" BorderBrush="#333"
                    Margin="0,0,0,12" CornerRadius="8" Focusable="True" FocusAdorner="{x:Null}">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Planned Events and Tasks" FontSize="14" FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <TextBlock x:Name="NoItemsText" Margin="4,12" IsVisible="False"
                                       Text="Nothing planned yet."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="ItemsStack" />
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="12" BorderThickness="1" BorderBrush="#333"
                    CornerRadius="8">
                <Panel>
                    <TextBlock x:Name="EditorEmptyText" Margin="4,18"
                               Text="Select an item above or add a new event/task"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <Grid x:Name="EditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                            <ComboBox Grid.Column="0" x:Name="KindBox" Width="110" Height="36"
                                      VerticalAlignment="Center" SelectionChanged="Kind_Changed" />
                            <TextBox Grid.Column="1" x:Name="TitleBox" Height="36" Margin="8,0,0,0"
                                     FontSize="15" FontWeight="SemiBold" PlaceholderText="Title..."
                                     VerticalContentAlignment="Center" TextChanged="EditorText_Changed" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Date" FontSize="11" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <DatePicker x:Name="ItemDatePicker" SelectedDateChanged="ItemDate_Changed" />
                            </StackPanel>

                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                                <CheckBox x:Name="AllDayCheck" Content="On the day" Height="34"
                                          IsCheckedChanged="AllDay_Changed" />
                            </StackPanel>
                            <StackPanel x:Name="TimePanel" Orientation="Horizontal">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Start (24h)" FontSize="11" Margin="0,0,0,3"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="StartTimeBox" Width="90" Height="34" MaxLength="5"
                                             PlaceholderText="HH:MM" TextChanged="EditorText_Changed"
                                             LostFocus="TimeBox_LostFocus" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="End (optional)" FontSize="11" Margin="0,0,0,3"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="EndTimeBox" Width="90" Height="34" MaxLength="5"
                                             PlaceholderText="HH:MM" TextChanged="EditorText_Changed"
                                             LostFocus="TimeBox_LostFocus" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <TextBox Grid.Row="2" x:Name="DescriptionBox" Margin="0,10,0,0" MinHeight="70"
                                 MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="Description, notes, links..." TextChanged="EditorText_Changed" />

                        <TextBlock Grid.Row="3" x:Name="EditorValidationMsg" FontSize="11" Foreground="OrangeRed"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
                            <Button Grid.Column="0" x:Name="DeleteItemBtn" Classes="danger" Height="34"
                                    Padding="12,0" Click="DeleteItem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ctl:SymIcon Glyph="Delete16" />
                                    <TextBlock Text="Delete" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Content="Close" Height="34" Width="80" Margin="0,0,8,0"
                                    Click="CloseEditor_Click" />
                            <Border Grid.Column="3" x:Name="SaveButtonBorder" CornerRadius="6" BorderThickness="2"
                                    BorderBrush="Transparent">
                                <Button x:Name="SaveItemBtn" Content="Save" Classes="accent" Width="100"
                                        Height="34" Click="SaveItem_Click" />
                            </Border>
                        </Grid>
                    </Grid>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>