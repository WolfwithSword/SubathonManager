<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctl="using:SubathonManager.UI.Controls"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             x:Class="SubathonManager.UI.Views.GoalsEditor">
    <Grid x:Name="RootGrid" Focusable="True" PointerPressed="Grid_PointerPressed" ColumnDefinitions="3*,2*">

        <Border Grid.Column="0" Padding="8" Margin="16,16,8,16" BorderThickness="1" BorderBrush="#333" CornerRadius="8">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="GoalSetNameBox" Width="640" Height="38" IsTabStop="False"
                             BorderThickness="0" FontSize="18" Background="Transparent" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" PlaceholderText="Set name..." FontWeight="Bold" Margin="2"
                             HorizontalAlignment="Left" LostFocus="GoalSetNameBox_LostFocus"/>
                    <Button Grid.Column="1" Classes="iconbtn" Width="34" Height="34" ToolTip.Tip="New Goal" Click="AddGoal_Click">
                        <ctl:SymIcon Glyph="Add16"/>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="8,12,8,2">
                    <TextBlock Text="Goal" Width="522"/>
                    <TextBlock Text="Points" Width="60" Margin="8,0,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="GoalsEditorScroller" MaxHeight="600" Height="600" VerticalScrollBarVisibility="Visible">
                    <StackPanel x:Name="GoalsStack" Orientation="Vertical" Margin="0,2,0,0"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,16,56" VerticalAlignment="Top">
                    <TextBlock Text="Goals Editor" FontSize="20" FontWeight="Bold"/>

                    <Grid Margin="0,10,0,10" ColumnDefinitions="*,Auto,Auto">
                        <ComboBox x:Name="GoalSetSelectorBox" Height="36" HorizontalAlignment="Stretch"
                                  SelectionChanged="GoalSetSelectorBox_SelectionChanged"/>
                        <Button Grid.Column="1" Classes="iconbtn" Width="34" Height="34" Margin="4,0,0,0"
                                ToolTip.Tip="New goal set" Click="NewGoalSet_Click">
                            <ctl:SymIcon Glyph="Add16"/>
                        </Button>
                        <Button Grid.Column="2" x:Name="DeleteGoalSetBtn" Classes="iconbtn" Width="34" Height="34" Margin="4,0,0,0"
                                ToolTip.Tip="Delete this goal set" Click="DeleteGoalSet_Click" Foreground="Red">
                            <ctl:SymIcon Glyph="Delete16"/>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="ExportGoalSet_Click" Height="30" Padding="12,4" Margin="0,0,6,0"
                                ToolTip.Tip="Export this goal set to CSV">
                            <ctl:SymIcon Glyph="ArrowExportUp16"/>
                        </Button>
                        <Button Click="ImportGoalSet_Click" Height="30" Padding="12,4"
                                ToolTip.Tip="Import a goal set from CSV">
                            <ctl:SymIcon Glyph="ArrowDownload16"/>
                        </Button>
                        <ComboBox x:Name="GoalSetType" Width="120" Height="36" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  ToolTip.Tip="Points will be based off points. Money is based on total donations."
                                  Margin="238,0,0,0" SelectionChanged="GoalSetType_SelectionChanged"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,8" ColumnDefinitions="*,*">
                        <TextBlock x:Name="MoneyValue" HorizontalAlignment="Left" Text="" VerticalAlignment="Center" FontSize="24" Margin="16,2,8,6"/>
                        <TextBlock Grid.Column="1" x:Name="PointsValue" HorizontalAlignment="Right" Text="" VerticalAlignment="Center" FontSize="24" Margin="0,2,16,6"/>
                    </Grid>

                    <Separator Margin="0,10,0,10"/>
                    <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="SaveButtonBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Margin="6,10,14,10">
                <Button x:Name="SaveGoalsBtn" Content="Save Changes" Classes="accent" Click="SaveGoals_Click" Width="140" Height="38"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
