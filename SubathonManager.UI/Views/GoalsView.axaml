<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             x:CompileBindings="False"
             x:Class="SubathonManager.UI.Views.GoalsView">
    <!-- <Grid MinHeight="200" MaxWidth="1000"> -->
        <Grid MinHeight="200"> 
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                      Padding="4" HorizontalAlignment="Stretch" Margin="4,8,16,4"
                      VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
            <ItemsControl x:Name="GoalsList" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,10" Padding="12" CornerRadius="6"
                                Background="{DynamicResource UiBrushControlBackground}"
                                BorderBrush="{DynamicResource UiBrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           FontSize="16"
                                           TextTrimming="CharacterEllipsis" Opacity="{Binding OpacityValue}"
                                           Foreground="{Binding TextColor}" />
                                <TextBlock Text="{Binding PointsText}" FontSize="14" Margin="0,4,0,0"
                                           TextDecorations="{Binding PointsDecoration}"
                                           Opacity="{Binding OpacityValue}"
                                           Foreground="{Binding PointsColor}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>