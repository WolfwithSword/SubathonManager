<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:ctl="using:SubathonManager.UI.Controls"
                       xmlns:v="using:SubathonManager.UI.Validation"
                       xmlns:ui2="using:SubathonManager.UI.UiUtils"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.ExternalSoftware.ObsSettings">
    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Margin="0 4 0 6">
            <Button x:Name="ObsConnectBtn" Content="Connect" Width="100" Height="30"
                    Margin="0 0 8 0" Click="ObsConnect_Click"
                    views:SettingsProperties.ExcludeFromUnsaved="True"/>
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0 0 4 0" FontSize="12"/>
            <TextBlock x:Name="ObsStatusText" VerticalAlignment="Center" FontSize="12" Text="Disconnected"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
            <TextBlock Text="Host:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="ObsHostBox" Width="140" PlaceholderText="localhost" Margin="0 0 32 0"
                     ui2:TextBoxAssist.Clear="True"
                     views:SettingsProperties.ExcludeFromUnsaved="True"/>
            <TextBlock Text="Port:" Width="32" VerticalAlignment="Center"/>
            <TextBox x:Name="ObsPortBox" Width="80" PlaceholderText="4455" Margin="12 0 8 0"
                     views:SettingsProperties.ExcludeFromUnsaved="True"
                     v:NumericInputBehaviour.Mode="Integer"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
            <TextBlock Text="Password:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="ObsPasswordBox" Width="220" Height="36" Margin="0 0 8 0"
                     PasswordChar="●" ui2:TextBoxAssist.Reveal="True" ui2:TextBoxAssist.Clear="True"/>
            <TextBlock Text="(leave blank if none)" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 4 0 6">
            <TextBlock Text="Helper Script:" Width="120" VerticalAlignment="Center"
                       ToolTip.Tip="A Lua script for OBS that lets SubathonManager have a better integration and allows advanced source edits (e.g. setting Blending Method to 'SRGB Off' on browser sources it creates)."/>
            <TextBlock x:Name="ScriptStatusText" Text="Unknown" VerticalAlignment="Center" FontSize="12"
                       Margin="0 0 12 0"/>
            <Button x:Name="CopyScriptPathBtn" Content="Copy Script Path" Height="30"
                    Click="CopyScriptPath_Click" Margin="0 0 6 0"
                    ToolTip.Tip="Copies path of the helper script. Add it once in OBS: Tools -> Scripts -> '+' -> paste this path. SubathonManager detects it automatically on connect."
                    views:SettingsProperties.ExcludeFromUnsaved="True"/>
            <Button x:Name="RecheckScriptBtn" Height="30" Padding="8 2"
                    Click="RecheckScript_Click"
                    ToolTip.Tip="Recheck for the helper script"
                    views:SettingsProperties.ExcludeFromUnsaved="True">
                <ctl:SymIcon Glyph="ArrowClockwise16"/>
            </Button>
        </StackPanel>
    </StackPanel>
</views:SettingsControl>
