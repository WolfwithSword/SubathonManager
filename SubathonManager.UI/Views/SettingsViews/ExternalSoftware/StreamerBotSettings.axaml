<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:ui2="using:SubathonManager.UI.UiUtils"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.ExternalSoftware.StreamerBotSettings">
    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
            <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Content="Get StreamerBot Extension" Click="OpenStreamerBotExtension_Click"
                    Width="240" Padding="2" Height="34" Cursor="Hand" />
            <TextBlock Text="Extension:" VerticalAlignment="Center" Margin="14,0,4,0" FontSize="12" />
            <TextBlock x:Name="StreamerBotStatusText" Text="Disconnected"
                       VerticalAlignment="Center" FontSize="12" />
            <TextBlock Text="HTTP API:" VerticalAlignment="Center" Margin="14,0,4,0" FontSize="12" />
            <TextBlock x:Name="HttpApiStatusText" Text="Disconnected"
                       VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,4"
                   Text="Import the .sb file into StreamerBot to setup the extension" />

        <TextBlock Text="Run Streamer.bot actions" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="2,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Lets custom actions run Streamer.bot actions. In Streamer.bot open Servers/Clients, HTTP Server, and start it (auto start is recommended). Extension not required." />
        <CheckBox x:Name="HttpEnabledCheck" Content="Use Streamer.bot's HTTP API" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="HTTP Server:" Width="120" VerticalAlignment="Center" />
            <TextBox x:Name="HttpUrlBox" Width="300" PlaceholderText="http://127.0.0.1:7474"
                     ui2:TextBoxAssist.Clear="True" />
            <Button Content="Check Connection" Height="32" Margin="8,0,0,0" Click="CheckHttp_Click"
                    ToolTip.Tip="Check Streamer.bot and refresh actions list using the address above"
                    views:SettingsProperties.ExcludeFromUnsaved="True" />
        </StackPanel>
        <TextBlock x:Name="HttpStatusText" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap" />
    </StackPanel>
</views:SettingsControl>