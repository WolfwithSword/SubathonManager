<external:DevTunnelSettingsControl xmlns="https://github.com/avaloniaui"
                                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                   xmlns:external="using:SubathonManager.UI.Views.SettingsViews.External"
                                   xmlns:views="using:SubathonManager.UI.Views"
                                   xmlns:v="using:SubathonManager.UI.Validation"
                                   xmlns:ui2="using:SubathonManager.UI.UiUtils"
                                   mc:Ignorable="d"
                                   x:Class="SubathonManager.UI.Views.SettingsViews.External.PatreonSettings">
    <StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                <TextBlock Text="Status:" Width="80" VerticalAlignment="Center" FontSize="12" />
                <TextBlock x:Name="WebhookStatusText" Text="Disconnected" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>

            <Border BorderThickness="1" CornerRadius="4" Padding="8,6"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DevTunnels:" Width="110" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock x:Name="TunnelPrereqStatusText" Text="Not running"
                                   VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" />
                        <Button Content="Go to setup" Click="GoToDevTunnels_Click" x:Name="TunnelPrereqHint"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="WebhookUrlRow" Orientation="Horizontal" Margin="0,8,0,2" IsVisible="False"
                                MinHeight="36">
                        <TextBlock Text="Webhook URL:" Width="110" VerticalAlignment="Center" FontSize="12" />
                        <TextBox x:Name="WebhookUrlBox" Width="420" Height="34" IsReadOnly="True" PasswordChar="●"
                                 ui2:TextBoxAssist.Reveal="True"
                                 views:SettingsProperties.ExcludeFromUnsaved="True" FontSize="11"
                                 VerticalAlignment="Center" />
                        <Button Content="Copy" Click="CopyWebhookUrl_Click" Width="56" Height="34" Padding="4,2"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,2,0" />
                        <Button Content="Manage" Click="ManageWebhooks_Click" Width="80" Height="34" Margin="4 0"
                                ToolTip.Tip="Open Patreon's webhook management page" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,4">
                <Button Content="Connect" Width="116" Height="34" Click="Connect_Click" x:Name="ConnectBtn" />
                <Button Content="Disconnect" Margin="4 0" Width="116" Height="34" Click="Disconnect_Click"
                        IsVisible="False" x:Name="DisconnBtn"
                        ToolTip.Tip="Removes the webhook from Patreon and forgets your login" />
                <Button Content="Recreate Webhook" Margin="4 0" Width="170" Height="34" Click="RecreateWebhook_Click"
                        IsVisible="False" x:Name="RecreateWebhookBtn"
                        ToolTip.Tip="Deletes and remakes the Patreon webhook. Use this if memberships stop coming in" />
            </StackPanel>
            <TextBlock FontSize="11" Margin="4,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="New pledges, renewals and paid pledge changes add time; upgrades count the difference. Free members, trials and downgrades do not. Tiers sync on connect" />

            <Separator Margin="0,8,0,8" />

            <StackPanel Margin="4,0,0,4" Spacing="2">
                <CheckBox x:Name="AsDonationBox" Content="Count the pledged amount as a donation"
                          ToolTip.Tip="Adds the amount pledged to the subathon money total"/>
                <CheckBox x:Name="ByAmountBox" Content="Add time/points per 1$ pledged instead of per tier"
                          IsCheckedChanged="ByAmount_Changed"
                          ToolTip.Tip="Scales off the amount pledged/charged (the full year for annual pledges). Only affects new pledges / not retroactive" />
            </StackPanel>
        </StackPanel>

        <Expander Header="Memberships" IsExpanded="True" Margin="0,5,0,0">
            <StackPanel>
                <StackPanel x:Name="PerUnitRow" Orientation="Horizontal" Margin="14,5,0,2">
                    <TextBlock Text="Per 1$ pledged:" Width="160" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12"
                             x:Name="PerUnitBox" Height="36" />
                    <TextBlock Margin="8,0,0,0" Text="Seconds" Width="120" VerticalAlignment="Center" />
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" Height="36"
                             PlaceholderText="0" x:Name="PerUnitBox2" />
                    <TextBlock Margin="8,0,0,0" Text="Points" Width="100" VerticalAlignment="Center" />
                    <TextBlock x:Name="PerUnitRateHint" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="MembershipsPanel" Margin="10,5,0,5">
                    <Grid x:Name="DefaultMember" Margin="0,2" ColumnDefinitions="*,400">
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Default:" Width="160" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="60"
                                     x:Name="SubDTextBox" Height="36" />
                            <TextBlock Margin="8,0,0,0" Text="Seconds" Width="120" VerticalAlignment="Center" />
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" Height="36"
                                     PlaceholderText="1" x:Name="SubDTextBox2" />
                            <TextBlock Margin="8,0,0,0" Text="Points" Width="100" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <ComboBox PlaceholderText="Duration" Width="110" Height="36" FontSize="12"
                                      x:Name="SimDuration" ToolTip.Tip="Select Monthly (x1) or Annual (x12)"
                                      views:SettingsProperties.ExcludeFromUnsaved="True" SelectedIndex="0" Margin="4,0,4,0">
                                <ComboBoxItem Content="Monthly" />
                                <ComboBoxItem Content="Annual" />
                            </ComboBox>

                            <ComboBox PlaceholderText="Tier" Width="150" Height="36" FontSize="12"
                                      x:Name="SimTierSelection" ToolTip.Tip="Select Membership Tier"
                                      views:SettingsProperties.ExcludeFromUnsaved="True" SelectedIndex="0" Margin="4,0,4,0">
                                <ComboBoxItem Content="DEFAULT" />
                            </ComboBox>
                            <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Test"
                                    Click="TestSub_Click" Width="60" Padding="2" Height="36" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</external:DevTunnelSettingsControl>
