<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:v="using:SubathonManager.UI.Validation"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.External.TiltifySettings">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ConnectBtn" Content="Connect" Width="120" Height="35"
                    Margin="0,5,0,10" Click="Connect_Click" />
            <Button x:Name="DisconnBtn" Content="Disconnect" Width="120" Height="35"
                    Margin="6,5,0,10" IsVisible="False" Click="Disconnect_Click" />
            <Button x:Name="ImportMissedBtn" Content="Import Missed" Width="120" Height="35"
                    Margin="6,5,0,10" IsVisible="False" Click="ImportMissed_Click"
                    ToolTip.Tip="Look up donations from your selected campaigns that were missed while disconnected" />
            <TextBlock x:Name="TiltifyStatusText" Text="Disconnected" VerticalAlignment="Center"
                       FontSize="12" Margin="14,0,0,10" />
        </StackPanel>
        <StackPanel Margin="10,0,0,5">
            <Grid Margin="0,2" ColumnDefinitions="*,470">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Donations:" Width="100" VerticalAlignment="Center" />
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12"
                             x:Name="DonoBox" />
                    <TextBlock Margin="8,0,0,0" Text="Seconds per 1$" Width="150" VerticalAlignment="Center" />
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0"
                             x:Name="DonoBox2" />
                    <TextBlock Margin="8,0,0,0" Text="Points per 1$" Width="150" ToolTip.Tip="Rounded down"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DonoRateHint" Text="" FontSize="11"
                               Foreground="Gray" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Margin="10,0,4,0" Width="80" Text="10.00" PlaceholderText="1.00"
                             VerticalAlignment="Center" FontSize="12" Height="34"
                             views:SettingsProperties.ExcludeFromUnsaved="True"
                             v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="SimulateAmountBox" />
                    <AutoCompleteBox Width="100" x:Name="CurrencyBox" Height="34"
                                     views:SettingsProperties.ExcludeFromUnsaved="True" Margin="4,0,4,0" />
                    <ComboBox Width="160" x:Name="TestCampaignBox" Height="34" Margin="4,0,4,0"
                              views:SettingsProperties.ExcludeFromUnsaved="True"
                              ToolTip.Tip="Campaign the test donation is tagged with" />
                    <Button Content="Test" Click="TestDonation_Click" Width="60" Padding="2" Height="34"
                            Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Margin="10,5,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Campaigns:" Width="100" VerticalAlignment="Center" />
                <Button x:Name="RefreshCampaignsBtn" Content="Refresh" Width="80" Height="30" Padding="2"
                        IsEnabled="False" Click="RefreshCampaigns_Click"
                        ToolTip.Tip="Reload your campaigns and your teams' campaigns from Tiltify" />
                <TextBlock x:Name="CampaignsHint" Text="Connect to load your campaigns" FontSize="11"
                           Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="CampaignsPanel" Margin="100,4,0,6" />
        </StackPanel>
    </StackPanel>
</views:SettingsControl>