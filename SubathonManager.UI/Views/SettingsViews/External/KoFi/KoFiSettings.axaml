<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.External.KoFi.KoFiSettings">
    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Setup" Click="OpenKoFiSetup_Click"
                    Width="60" Padding="2" Height="34" Margin="0,0,6,0"/>
            <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Copy StreamerBot Import String"
                    Click="CopyImportString_Click" Width="240" Padding="2" Height="34" Margin="6,0,0,0"/>
            <TextBlock x:Name="KoFiStatusText" Text="Disconnected" VerticalAlignment="Center" FontSize="12" Margin="14,0,0,0"/>
        </StackPanel>
        <TextBlock Text="KoFi via StreamerBot remains available, however, the DevTunnel method is now preferred"
                   VerticalAlignment="Center" FontSize="12" Margin="2,0,0,0"/>
    </StackPanel>
</views:SettingsControl>
