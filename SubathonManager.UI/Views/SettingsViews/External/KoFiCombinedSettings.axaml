<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:v="using:SubathonManager.UI.Validation"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.External.KoFiCombinedSettings">
    <StackPanel>
        <!-- Connection type toggle (legacy) -->
        <StackPanel x:Name="MethodTogglePanel" Orientation="Horizontal" Margin="0,0,0,10"
                    views:SettingsProperties.ExcludeFromUnsaved="True">
            <TextBlock Text="Method: " Margin="0 0 12 0" TextAlignment="Center" VerticalAlignment="Center"/>
            <RadioButton x:Name="WebhookRadio" Content="DevTunnel" IsChecked="True"
                         GroupName="KoFiConn" IsCheckedChanged="ConnectionType_Checked" VerticalAlignment="Center"/>
            <RadioButton x:Name="SocketRadio" Content="StreamerBot" Margin="16,0,0,0"
                         GroupName="KoFiConn" IsCheckedChanged="ConnectionType_Checked" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Socket sub-control slot -->
        <StackPanel x:Name="SocketSlot" views:SettingsProperties.ExcludeFromUnsaved="True"/>

        <!-- Webhook sub-control slot -->
        <StackPanel x:Name="WebhookSlot" IsVisible="False" views:SettingsProperties.ExcludeFromUnsaved="True"/>

        <Separator Margin="0,8,0,8"/>

        <!-- Shared: conversion settings -->
        <StackPanel Margin="10,5,0,5">
            <Grid Margin="0,4" ColumnDefinitions="*,300">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Donations:" Width="100" VerticalAlignment="Center" ToolTip.Tip="Donations and Monthly Tips"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12" x:Name="DonoBox"/>
                    <TextBlock Margin="8,0,0,0" Text="Seconds per 1$" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="DonoBox2"/>
                    <TextBlock Margin="8,0,0,0" Text="Points per 1$, rounded down" Width="180" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Margin="10,0,4,0" Width="80" Text="10.00" PlaceholderText="1.00" VerticalAlignment="Center" FontSize="12" Height="34"
                             views:SettingsProperties.ExcludeFromUnsaved="True" v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="SimulateKFTipAmountBox"/>
                    <AutoCompleteBox Width="100" x:Name="CurrencyBox" Height="34"
                                     views:SettingsProperties.ExcludeFromUnsaved="True" Margin="4,0,4,0"/>
                    <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Test" Click="TestKoFiTip_Click"
                            Width="60" Padding="2" Height="34" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,4" ColumnDefinitions="*,300">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Commissions:" Width="100" VerticalAlignment="Center" ToolTip.Tip="Commission services offered via Ko-fi (webhook only)"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12" x:Name="CommissionBox"/>
                    <TextBlock Margin="8,0,0,0" Text="Seconds per 1$" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="CommissionBox2"/>
                    <TextBlock Margin="8,0,0,0" Text="Points per 1$, rounded down" Width="180" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Margin="10,0,4,0" Width="80" Text="10.00" PlaceholderText="1.00" VerticalAlignment="Center" FontSize="12" Height="34"
                             views:SettingsProperties.ExcludeFromUnsaved="True" v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="SimulateKFCommissionAmountBox"/>
                    <AutoCompleteBox Width="100" x:Name="CommissionCurrencyBox" Height="34"
                                     views:SettingsProperties.ExcludeFromUnsaved="True" Margin="4,0,4,0"/>
                    <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Test" Click="TestKoFiCommission_Click"
                            Width="60" Padding="2" Height="34" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0 4" ColumnDefinitions="*,400">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Orders:" Width="100" VerticalAlignment="Center" x:Name="KoFiOrdersText"
                               ToolTip.Tip="Direct shop orders from the Ko-Fi store (webhook only)"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12" x:Name="ShopOrderBox"/>
                    <TextBlock Margin="8,0,0,0" Text="Seconds" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="ShopOrderBox2"/>
                    <TextBlock Margin="8,0,0,0" Text="Points" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="Per: " VerticalAlignment="Center" Width="30" Margin="12 0 2 0"/>
                    <ComboBox PlaceholderText="Mode" Width="100" x:Name="ModeBox" SelectedIndex="0" Margin="4 0 4 0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Margin="10 0 4 0" Width="50" Text="1" PlaceholderText="5" VerticalAlignment="Center" FontSize="12" Height="34"
                             ToolTip.Tip="Number of items in the order to sum the amount"
                             views:SettingsProperties.ExcludeFromUnsaved="True" v:NumericInputBehaviour.Mode="Integer" x:Name="OrderQuantitySimBox"/>
                    <TextBox Margin="4 0 4 0" Width="80" Text="29.99" PlaceholderText="1.00" VerticalAlignment="Center" FontSize="12" Height="34"
                             views:SettingsProperties.ExcludeFromUnsaved="True" v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="OrderTotalSimBox"/>
                    <AutoCompleteBox Width="100" x:Name="OrderCurrencyBox" Height="34"
                                     views:SettingsProperties.ExcludeFromUnsaved="True" Margin="4,0,4,0"/>
                    <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Test" Click="TestKoFiShopOrder_Click"
                            Width="60" Padding="2" Height="34" views:SettingsProperties.ExcludeFromUnsaved="True" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0 2 0 0" ColumnDefinitions="*,400">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <CheckBox x:Name="OrderCommissionBox" Content="Add order value as donation?" Margin="-10 0 0 0"/>
                    <CheckBox x:Name="CommCommissionBox" Content="Add commission value as donation?" Margin="14 0 0 0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Memberships -->
        <Expander Header="Memberships" IsExpanded="False" Margin="0,5,0,0">
            <StackPanel x:Name="MembershipsPanel" Margin="10,5,0,5">
                <Grid x:Name="DefaultMember" Margin="0,2" ColumnDefinitions="*,400">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="Default:" Width="160" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="60" x:Name="KFSubDTextBox" Height="36"/>
                        <TextBlock Margin="8,0,0,0" Text="Seconds" Width="120" VerticalAlignment="Center"/>
                        <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" Height="36" PlaceholderText="1" x:Name="KFSubDTextBox2"/>
                        <TextBlock Margin="8,0,0,0" Text="Points" Width="100" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Height="36"
                                Content="Add Membership Tier" x:Name="AddBtn" Click="AddMembership_Click" Width="160" Margin="4,5,4,5"/>
                        <ComboBox PlaceholderText="Tier" Width="150" Height="36" FontSize="12" x:Name="SimKoFiTierSelection"
                                  ToolTip.Tip="Select Membership Tier" views:SettingsProperties.ExcludeFromUnsaved="True"
                                  SelectedIndex="0" Margin="4,0,4,0">
                            <ComboBoxItem Content="DEFAULT"/>
                        </ComboBox>
                        <Button Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Test" Click="TestKoFiSub_Click"
                                Width="60" Padding="2" Height="36" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</views:SettingsControl>
