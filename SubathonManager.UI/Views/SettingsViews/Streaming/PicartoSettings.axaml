<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:v="using:SubathonManager.UI.Validation"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.Streaming.PicartoSettings">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
            <Button x:Name="ConnectPicartoBtn" Content="Connect" Width="120" VerticalAlignment="Center"
                    Height="35" Margin="0,5,0,10" Click="ConnectPicartoButton_Click"/>
            <TextBox x:Name="PicartoUserBox" PlaceholderText="ChannelName" VerticalAlignment="Center" FontSize="12" Width="250" Margin="14 5 12 10"/>
            <TextBlock Text="Chat: " VerticalAlignment="Center" FontSize="12" Margin="14 0 0 0"/>
            <TextBlock x:Name="PicartoChatStatusText" Text="Disconnected" VerticalAlignment="Center" FontSize="12" Margin="2 0 14 0"/>
            <TextBlock Text="Alerts: " VerticalAlignment="Center" FontSize="12" Margin="14 0 0 0"/>
            <TextBlock x:Name="PicartoClientStatusText" Text="Disconnected" VerticalAlignment="Center" FontSize="12" Margin="2 0 0 0"/>
        </StackPanel>

        <StackPanel Margin="10,5,0,5">
            <!-- Kudos -->
            <Grid Margin="0,2" ColumnDefinitions="*,300">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Kudos:" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="KudosTextBox" PlaceholderText="12"/>
                    <TextBlock Margin="8 0 0 0" Text="Seconds per 100" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" x:Name="Kudos2TextBox" PlaceholderText="0"/>
                    <TextBlock Margin="8 0 0 0" Text="Points per 100, rounded down" Width="150" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Margin="10 0 4 0" Width="80" Text="100" PlaceholderText="100" VerticalAlignment="Center" Height="30" FontSize="12"
                             views:SettingsProperties.ExcludeFromUnsaved="True" v:NumericInputBehaviour.Mode="Integer" x:Name="SimulateTipAmt"/>
                    <Button Content="Test" Click="TestPicartoTip_Click" Width="60" Padding="2" Height="30" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Follows -->
            <Grid Margin="0,2" ColumnDefinitions="*,300">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Follows:" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="FollowTextBox"/>
                    <TextBlock Margin="8 0 0 0" Text="Seconds" Width="150" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="Follow2TextBox"/>
                    <TextBlock Margin="8 0 0 0" Text="Points" Width="150" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Test" Click="TestPicartoFollow_Click" Width="60" Padding="2" Height="30" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Subs -->
            <Expander Header="Subscriptions" IsExpanded="False" Margin="0,5,0,0">
                <StackPanel Margin="10,5,0,5">
                    <Grid Margin="0,2" ColumnDefinitions="*,300">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="T1 Sub:" Width="100" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="60" x:Name="SubT1TextBox"/>
                            <TextBlock Margin="8 0 0 0" Text="Seconds" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="1" x:Name="SubT1TextBox2"/>
                            <TextBlock Margin="8 0 0 0" Text="Points" Width="100" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox Width="120" x:Name="SimSubTierSelection" views:SettingsProperties.ExcludeFromUnsaved="True" SelectedIndex="0" Margin="4 0 4 0">
                                <ComboBoxItem Content="Tier 1"/>
                                <ComboBoxItem Content="Tier 2"/>
                                <ComboBoxItem Content="Tier 3"/>
                            </ComboBox>
                            <Button Content="Test" Click="TestPicartoSub_Click" Width="60" Padding="2" Height="35" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,2" ColumnDefinitions="*,300">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="T2 Sub:" Width="100" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="120" x:Name="SubT2TextBox"/>
                            <TextBlock Margin="8 0 0 0" Text="Seconds" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="2" x:Name="SubT2TextBox2"/>
                            <TextBlock Margin="8 0 0 0" Text="Points" Width="100" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
                            <ComboBox Width="120" Height="35" x:Name="SimSubMonthSelection" views:SettingsProperties.ExcludeFromUnsaved="True" SelectedIndex="0" Margin="4 0 4 0">
                                <ComboBoxItem Content="1 Month"/>
                                <ComboBoxItem Content="3 Months"/>
                                <ComboBoxItem Content="6 Months"/>
                                <ComboBoxItem Content="12 Months"/>
                            </ComboBox>
                            <Button Content="Test" Click="TestPicartoSubMonths_Click" Width="60" Padding="2" Height="35" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="T3 Sub:" Width="100" VerticalAlignment="Center"/>
                        <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="180" x:Name="SubT3TextBox"/>
                        <TextBlock Margin="8 0 0 0" Text="Seconds" Width="120" VerticalAlignment="Center"/>
                        <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="3" x:Name="SubT3TextBox2"/>
                        <TextBlock Margin="8 0 0 0" Text="Points" Width="100" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Margin="0,8"/>

                    <!-- gift -->
                    <Grid Margin="0,2" ColumnDefinitions="*,300">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="GiftSub:" Width="100" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="60" x:Name="GiftSubTextBox"/>
                            <TextBlock Margin="8 0 0 0" Text="Seconds" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="1" x:Name="GiftSubTextBox2"/>
                            <TextBlock Margin="8 0 0 0" Text="Points" Width="100" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Width="100" v:NumericInputBehaviour.Mode="Integer" views:SettingsProperties.ExcludeFromUnsaved="True"
                                     Text="1" PlaceholderText="1" Height="35" FontSize="14" Margin="0 0 4 0" x:Name="SimGiftSubAmtInput"/>
                            <ComboBox Width="120" x:Name="SimGiftSubMonthSelection" Height="35" views:SettingsProperties.ExcludeFromUnsaved="True" SelectedIndex="0" Margin="4 0 4 0">
                                <ComboBoxItem Content="1 Month"/>
                                <ComboBoxItem Content="3 Months"/>
                                <ComboBoxItem Content="6 Months"/>
                                <ComboBoxItem Content="12 Months"/>
                            </ComboBox>
                            <Button Content="Test" Click="TestPicartoGiftSub_Click" Width="60" Padding="2" Height="35" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </StackPanel>
</views:SettingsControl>
