<views:SettingsControl xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:views="using:SubathonManager.UI.Views"
                       xmlns:v="using:SubathonManager.UI.Validation"
                       xmlns:ui2="using:SubathonManager.UI.UiUtils"
                       mc:Ignorable="d"
                       x:Class="SubathonManager.UI.Views.SettingsViews.Extensions.TangiaSettings">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
            <TextBox x:Name="EventKeyBox" Width="200" Height="35" PlaceholderText="Event Key" PasswordChar="●"
                     IsReadOnly="True" ui2:TextBoxAssist.Reveal="True"
                     views:SettingsProperties.ExcludeFromUnsaved="True" Margin="0,0,8,0"/>
            <Button x:Name="GetKeyBtn" Content="Get Key" Width="80" Height="35" Margin="0,0,8,0" Click="GetKey_Click"/>
            <Button x:Name="DisconnectBtn" Content="Disconnect" Width="100" Height="35" Margin="0,0,8,0"
                    IsVisible="False" Click="Disconnect_Click"/>
            <TextBlock x:Name="StatusText" Text="Disconnected" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Margin="10,5,0,5">
            <Grid Margin="0,2" ColumnDefinitions="*,200">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Tokens:" Width="80" VerticalAlignment="Center" ToolTip.Tip="Covers both Bits and Tangia Coins"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="12" x:Name="TokensSecondsBox"/>
                    <TextBlock Margin="8,0,0,0" Text="Seconds/100" Width="110" VerticalAlignment="Center"/>
                    <TextBox Width="100" v:NumericInputBehaviour.Mode="SignedDecimal" PlaceholderText="0" x:Name="TokensPointsBox"/>
                    <TextBlock Margin="8,0,0,0" Text="Points/100" ToolTip.Tip="Rounded down" Width="140" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Width="80" Text="100" PlaceholderText="100" VerticalAlignment="Center" Height="34" FontSize="12"
                             views:SettingsProperties.ExcludeFromUnsaved="True"
                             v:NumericInputBehaviour.Mode="Integer" x:Name="SimulateTangiaAmt"/>
                    <Button Content="Test" Click="TestTangia_Click" Width="60" Padding="2" Height="34" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</views:SettingsControl>
